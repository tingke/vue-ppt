{
  "name": "@vue-ppt-kit/vue3",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "element-plus": "^2.7.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.2",
    "element-plus": "^2.7.8",
    "typescript": "~5.5.4",
    "vite": "^5.4.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.29"
  },
  "dependencies": {
    "@vue-ppt-kit/core": "workspace:*",
    "@vue-ppt-kit/theme": "workspace:*",
    "vuedraggable": "^4.1.0"
  }
}
