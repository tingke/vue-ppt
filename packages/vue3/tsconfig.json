{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ES2020", "DOM"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@vpk/shared/*": ["../shared/src/*"],
      "@vpk/vue-api": ["./src/vue-api.ts"],
      "@vpk/shells": ["./src/shells.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
