{
  "name": "@tthappy/ppt-vue2",
  "version": "0.3.0",
  "publishConfig": { "access": "public" },
  "browserslist": [
    "chrome >= 61",
    "firefox >= 60",
    "safari >= 11",
    "edge >= 79",
    "ios_saf >= 11",
    "not dead"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "vite build"
  },
  "peerDependencies": {
    "vue": ">=2.6.14 <3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.1",
    "@vue/composition-api": "^1.7.2",
    "typescript": "~5.5.4",
    "vite": "^5.4.0",
    "vue": "2.7.16"
  },
  "dependencies": {
    "@tthappy/ppt-core": "workspace:*",
    "vuedraggable": "2.24.3"
  }
}
