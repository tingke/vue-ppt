{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["es2018", "dom"],
    "baseUrl": ".",
    "paths": {
      "@vpk/shared/*": ["../shared/src/*"],
      "@vpk/vue-api": ["./src/vue-api.ts"],
      "@vpk/shells": ["./src/shells.ts"]
    }
  },
  "include": ["src/**/*"]
}
